#!/usr/bin/env bash
set -u
DOMAIN=''
PROXY_PORT=443
WEB_PORT=443
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
SITE=/var/www/far-and-field
STATE=/var/lib/far-field-hysteria
CONFIG_DIR=/etc/hysteria
CONFIG=$CONFIG_DIR/config.yaml
SERVICE=hysteria-server.service
BINARY=/usr/local/bin/hysteria
UNIT_DIR=/etc/systemd/system
CLI_PATH=/usr/local/bin/hysteria-maintain
BUNDLE=/usr/local/share/hysteria-maintain
umask 077

require_root() { (( EUID == 0 )) || { echo '请使用 sudo 运行。'; return 1; }; }
owned() { [[ -f $STATE/owned ]]; }
confirm() { local answer; read -r -p "$1 [y/N] " answer || return 1; [[ $answer == y || $answer == Y ]]; }

valid_domain() {
  local label
  local -a labels
  [[ ${#1} -le 253 && $1 == *.* && $1 != *..* && $1 != .* && $1 != *. ]] || return 1
  IFS=. read -r -a labels <<< "$1"
  for label in "${labels[@]}"; do
    [[ ${#label} -le 63 && $label =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?$ ]] || return 1
  done
}

load_domain() {
  local saved=''
  if [[ -r $STATE/domain ]]; then
    read -r saved < "$STATE/domain"
  elif [[ -r $CONFIG ]]; then
    saved=$(awk '/^acme:/ {acme=1; next} acme && /^[^[:space:]]/ {exit} acme && /^[[:space:]]+- / {print $2; exit}' "$CONFIG")
  fi
  if valid_domain "$saved"; then DOMAIN=$saved; fi
}

valid_port() {
  [[ $1 =~ ^[0-9]{1,5}$ ]] && (( 10#$1 >= 1 && 10#$1 <= 65535 ))
}

load_settings() {
  load_domain
  PROXY_PORT=443
  WEB_PORT=443
  local saved_proxy='' saved_web=''
  if [[ -r $CONFIG ]]; then
    saved_proxy=$(awk '$1 == "listen:" {sub(/^.*:/,"",$2); print $2; exit}' "$CONFIG")
    saved_web=$(awk '$1 == "listenHTTPS:" {sub(/^.*:/,"",$2); print $2; exit}' "$CONFIG")
  fi
  if valid_port "$saved_proxy"; then PROXY_PORT=$((10#$saved_proxy)); fi
  if valid_port "$saved_web"; then WEB_PORT=$((10#$saved_web)); fi
}

installation_wizard() {
  local requested_domain requested_proxy requested_web
  echo 'Hysteria 2 首次安装向导'
  echo '1/3 填写服务器域名，例如 example.com；不需要 https:// 或路径。'
  while true; do
    read -r -p '服务器域名：' requested_domain || return 1
    if valid_domain "$requested_domain"; then break; fi
    echo '域名格式无效，请重新填写。'
  done
  echo '2/3 填写 Hysteria 代理 UDP 端口。'
  while true; do
    read -r -p '代理 UDP 端口 [443]：' requested_proxy || return 1
    requested_proxy=${requested_proxy:-443}
    if valid_port "$requested_proxy"; then requested_proxy=$((10#$requested_proxy)); break; fi
    echo '请输入 1–65535 之间的端口。'
  done
  echo '3/3 填写网站 HTTPS TCP 端口；可以与代理使用相同数字。'
  while true; do
    read -r -p '网站 HTTPS 端口 [443]：' requested_web || return 1
    requested_web=${requested_web:-443}
    if valid_port "$requested_web"; then
      requested_web=$((10#$requested_web))
      if (( requested_web != 80 )); then break; fi
      echo 'TCP 80 保留给证书 HTTP 验证，请选择其他 HTTPS 端口。'
    else
      echo '请输入 1–65535 之间的端口。'
    fi
  done
  printf '\n安装参数\n域名：%s\n代理：UDP %s\n网站：https://%s:%s/\n证书验证：TCP 80（固定）\n' "$requested_domain" "$requested_proxy" "$requested_domain" "$requested_web"
  printf '请在云端和系统防火墙放行：UDP %s、TCP %s、TCP 80。\n' "$requested_proxy" "$requested_web"
  echo '网站将自动安装 Far & Field，代理密码自动生成。'
  confirm '确认按以上参数开始安装？' || { echo '已取消安装。'; return 2; }
  DOMAIN=$requested_domain
  PROXY_PORT=$requested_proxy
  WEB_PORT=$requested_web
}

check_ports_available() {
  local port listeners
  for port in 80 "$WEB_PORT"; do
    listeners=$(ss -H -lnt "sport = :$port") || { echo '无法检查 TCP 端口占用。'; return 1; }
    [[ -z $listeners ]] || { echo "TCP ${port} 已被占用，停止安装。"; return 1; }
  done
  listeners=$(ss -H -lnu "sport = :$PROXY_PORT") || { echo '无法检查 UDP 端口占用。'; return 1; }
  [[ -z $listeners ]] || { echo "UDP ${PROXY_PORT} 已被占用，停止安装。"; return 1; }
}

ensure_dependencies() {
  [[ $(uname -s) == Linux && -d /run/systemd/system ]] || { echo '安装需要运行 systemd 的 Linux。'; return 1; }
  local command_name missing=0
  for command_name in curl openssl unzip zipinfo sha256sum ss timeout getent; do
    command -v "$command_name" >/dev/null || missing=1
  done
  if (( missing )); then
    command -v apt-get >/dev/null || { echo '请先安装 curl openssl unzip iproute2 coreutils libc-bin util-linux。'; return 1; }
    apt-get update && apt-get install -y ca-certificates curl openssl unzip iproute2 coreutils libc-bin util-linux || return 1
  fi
}

find_website_archive() {
  if [[ -f $SCRIPT_DIR/assets/far-and-field.zip ]]; then
    printf '%s\n' "$SCRIPT_DIR/assets/far-and-field.zip"
  elif [[ -f $BUNDLE/assets/far-and-field.zip ]]; then
    printf '%s\n' "$BUNDLE/assets/far-and-field.zip"
  else
    echo '找不到随项目附带的 assets/far-and-field.zip，请上传完整项目。' >&2; return 1
  fi
}

validate_website_archive() {
  local archive=$1 expected actual entries
  [[ -r $archive && -r $archive.sha256 ]] || { echo '网站 ZIP 或校验文件缺失。' >&2; return 1; }
  expected=$(awk 'NR==1 {print $1}' "$archive.sha256")
  actual=$(sha256sum "$archive" | awk '{print $1}')
  [[ $expected =~ ^[0-9a-f]{64}$ && $expected == "$actual" ]] || { echo '网站 ZIP 校验失败。' >&2; return 1; }
  unzip -tq "$archive" >/dev/null || { echo '网站 ZIP 已损坏。' >&2; return 1; }
  entries=$(unzip -Z1 "$archive") || return 1
  if printf '%s\n' "$entries" | grep -Eq '(^/|(^|/)\.\.(/|$)|\\|^[A-Za-z]:)' || zipinfo -l "$archive" | awk '$1 ~ /^l/ {found=1} END {exit !found}'; then
    echo '网站 ZIP 含不安全路径或符号链接。' >&2; return 1
  fi
  printf '%s\n' "$entries" | grep -qx 'index.html' && printf '%s\n' "$entries" | grep -q '^assets/' || { echo '网站 ZIP 根目录必须包含 index.html 和 assets/。' >&2; return 1; }
}

install_website() {
  local archive=$1 staging
  validate_website_archive "$archive" || return 1
  mkdir -p "$(dirname "$SITE")" || return 1
  staging=$(mktemp -d "${SITE}.tmp.XXXXXX") || return 1
  if ! unzip -q "$archive" -d "$staging" || ! chmod -R a+rX "$staging" || [[ ! -f $staging/index.html ]]; then
    rm -rf -- "$staging"; return 1
  fi
  # Never merge into or replace a pre-existing website.
  if [[ -e $SITE ]]; then rm -rf -- "$staging"; echo '网站目录已存在，停止覆盖。'; return 1; fi
  mv "$staging" "$SITE"
}

persist_bundle() {
  local archive=$1 destination=$BUNDLE/assets/far-and-field.zip
  mkdir -p "$BUNDLE/assets" "$(dirname "$CLI_PATH")" || return 1
  if [[ $archive != "$destination" ]]; then
    install -m 644 "$archive" "$destination" && install -m 644 "$archive.sha256" "$destination.sha256" || return 1
  fi
  if [[ $SCRIPT_DIR/hysteria-maintain != "$CLI_PATH" ]]; then
    install -m 755 "$SCRIPT_DIR/hysteria-maintain" "$CLI_PATH.new" && mv "$CLI_PATH.new" "$CLI_PATH" || return 1
  fi
}

wait_for_https() {
  local wait_seconds=${1:-60} deadline code=''
  deadline=$((SECONDS + wait_seconds))
  printf '正在等待 HTTPS 就绪（最多 %s 秒，首次签发证书需要时间）……\n' "$wait_seconds"
  while (( SECONDS < deadline )); do
    if ! systemctl is-active --quiet "$SERVICE"; then
      echo '服务尚未运行，请检查下列状态和菜单 3 的日志。'; return 1
    fi
    if code=$(curl --noproxy '*' -sS --connect-timeout 1 --max-time 2 --resolve "$DOMAIN:$WEB_PORT:127.0.0.1" "https://$DOMAIN:$WEB_PORT/" -o /dev/null -w '%{http_code}' 2>/dev/null) && [[ $code == 200 ]]; then
      return 0
    fi
    sleep 2
  done
  echo '等待 HTTPS 就绪超时，请查看下列状态和菜单 3 的证书日志。'
  return 1
}

installed_version() {
  "$BINARY" version 2>/dev/null | awk '$1 == "Version:" {print $2; exit}'
}

verify_upgrade() {
  local expected=$1 config_hash=$2 password_hash=$3 site_hash=$4 pid
  [[ $(installed_version) == "$expected" ]] || { echo '升级后版本不符合预期。'; return 1; }
  [[ $(sha256sum "$CONFIG" | awk '{print $1}') == "$config_hash" &&
     $(sha256sum "$STATE/password" | awk '{print $1}') == "$password_hash" &&
     $(sha256sum "$SITE/index.html" | awk '{print $1}') == "$site_hash" ]] || {
    echo '升级后配置、密码或网站首页发生变化。'; return 1;
  }
  systemctl is-active --quiet "$SERVICE" || { echo '升级后服务未运行。'; return 1; }
  pid=$(systemctl show "$SERVICE" --property=MainPID --value) || return 1
  [[ $pid =~ ^[1-9][0-9]*$ ]] || { echo '升级后无法读取服务进程。'; return 1; }
  ss -H -lnup "sport = :$PROXY_PORT" | grep -Fq "pid=$pid," || { echo "升级后 UDP $PROXY_PORT 未监听。"; return 1; }
  ss -H -lntp "sport = :$WEB_PORT" | grep -Fq "pid=$pid," || { echo "升级后 TCP $WEB_PORT 未监听。"; return 1; }
  wait_for_https 60 || return 1
}

rollback_upgrade() {
  local backup=$1 expected=$2 config_hash=$3 password_hash=$4 site_hash=$5
  echo "升级验证失败，正在从 $backup 恢复程序和服务文件。"
  cp -a -- "$backup/hysteria" "$BINARY.rollback.$$" &&
    mv -f -- "$BINARY.rollback.$$" "$BINARY" &&
    cp -a -- "$backup/config.yaml" "$CONFIG" &&
    cp -a -- "$backup/password" "$STATE/password" &&
    cp -a -- "$backup/install-official.sh" "$STATE/install-official.sh" &&
    cp -a -- "$backup/hysteria-server.service" "$UNIT_DIR/hysteria-server.service" &&
    cp -a -- "$backup/hysteria-server@.service" "$UNIT_DIR/hysteria-server@.service" &&
    systemctl daemon-reload && systemctl restart "$SERVICE" &&
    verify_upgrade "$expected" "$config_hash" "$password_hash" "$site_hash" || {
      echo "[异常] 自动恢复失败；备份保留在 ${backup}，请人工检查服务。"
      return 1
    }
  echo "已恢复原版本 $(installed_version)；备份保留在 ${backup}。"
}

upgrade_service() {
  local installer check_output current latest backup config_hash password_hash site_hash
  require_root || return 1
  owned && [[ -x $BINARY && -r $CONFIG && -r $SITE/index.html && -r $STATE/password && -r $STATE/install-official.sh &&
    -r $UNIT_DIR/hysteria-server.service && -r $UNIT_DIR/hysteria-server@.service ]] || {
    echo '没有找到完整的本项目安装，停止升级。'; return 1;
  }
  systemctl is-active --quiet "$SERVICE" || { echo '服务当前未运行，请先检查状态，停止升级。'; return 1; }
  load_settings
  current=$(installed_version)
  [[ $current =~ ^v2\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.-]+)?$ ]] || {
    echo '无法识别当前 Hysteria 2 版本，停止升级。'; return 1;
  }
  echo "当前版本：${current}；正在查询官方最新版本。"
  installer=$(mktemp "$STATE/upgrade-installer.XXXXXX") || return 1
  if ! curl -fsSL --retry 3 https://get.hy2.sh/ -o "$installer" || ! bash -n "$installer"; then
    rm -f -- "$installer"; echo '官方安装脚本下载或语法检查失败，未修改服务。'; return 1
  fi
  check_output=$(HYSTERIA_USER=root bash "$installer" --check 2>&1) || {
    rm -f -- "$installer"; echo '官方版本查询失败，未修改服务。'; return 1;
  }
  latest=$(printf '%s\n' "$check_output" | awk '/Checking for latest version/ {print $NF}' | tail -1)
  if [[ ! $latest =~ ^v2\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.-]+)?$ ]]; then
    rm -f -- "$installer"; echo '官方未返回有效的 Hysteria 2 版本，未修改服务。'; return 1
  fi
  printf '官方最新：%s\n' "$latest"
  if [[ $current == "$latest" ]]; then
    confirm '已经是最新版本，是否用官方脚本重新安装同版本以检查升级流程？' || {
      rm -f -- "$installer"; echo '未修改服务。'; return 0;
    }
  elif [[ $(printf '%s\n' "$latest" "$current" | sort -V | head -1) == "$latest" ]]; then
    rm -f -- "$installer"; echo '当前版本高于官方稳定版，停止以避免降级。'; return 1
  else
    confirm "是否升级到 ${latest}？升级会短暂中断代理连接" || {
      rm -f -- "$installer"; echo '已取消升级。'; return 0;
    }
  fi
  backup=$(mktemp -d "$STATE/upgrade-backup-$(date +%Y%m%d-%H%M%S).XXXXXX") || {
    rm -f -- "$installer"; return 1;
  }
  if ! cp -a -- "$BINARY" "$CONFIG" "$STATE/password" "$STATE/install-official.sh" \
    "$UNIT_DIR/hysteria-server.service" "$UNIT_DIR/hysteria-server@.service" "$backup/"; then
    rm -f -- "$installer"; echo '备份失败，未修改服务。'; return 1
  fi
  config_hash=$(sha256sum "$CONFIG" | awk '{print $1}')
  password_hash=$(sha256sum "$STATE/password" | awk '{print $1}')
  site_hash=$(sha256sum "$SITE/index.html" | awk '{print $1}')
  echo "升级前备份：$backup"
  if ! HYSTERIA_USER=root bash "$installer" --version "$latest" --force ||
     ! verify_upgrade "$latest" "$config_hash" "$password_hash" "$site_hash"; then
    rm -f -- "$installer"
    rollback_upgrade "$backup" "$current" "$config_hash" "$password_hash" "$site_hash" || true
    return 1
  fi
  install -m 600 "$installer" "$STATE/install-official.sh" || {
    rm -f -- "$installer"; rollback_upgrade "$backup" "$current" "$config_hash" "$password_hash" "$site_hash" || true; return 1;
  }
  rm -f -- "$installer"
  echo "升级验证通过：${current} → ${latest}；域名、端口、密码和网站已保留。"
  check_status
}

install_service() {
  local pass backup archive wizard_result
  require_root || return 1
  load_settings
  if owned; then
    printf '当前配置：域名 %s · 代理 UDP %s · 网站 TCP %s\n' "$DOMAIN" "$PROXY_PORT" "$WEB_PORT"
    confirm '已安装，是否重新安装？将保留密码并备份配置' || return 0
    ensure_dependencies || return 1
    archive=$(find_website_archive) && validate_website_archive "$archive" || return 1
    [[ -r $STATE/password && -r $CONFIG ]] || { echo '已有安装不完整，请先检查，未作更改。'; return 1; }
    backup="$STATE/backup-$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$backup" && cp -a "$CONFIG" "$STATE/password" "$backup/" || return 1
    echo "配置备份：${backup}；保留现有配置和网站。"
    [[ -f $STATE/install-official.sh ]] || { echo '缺少官方安装脚本，停止操作。'; return 1; }
    if [[ ! -e $SITE ]]; then install_website "$archive" || return 1; fi
    HYSTERIA_USER=root bash "$STATE/install-official.sh" --force || return 1
    printf '%s\n' "$DOMAIN" > "$STATE/domain"
    persist_bundle "$archive" || return 1
    systemctl enable --now "$SERVICE" && systemctl restart "$SERVICE" || return 1
    wait_for_https || true
    check_status
    return
  fi
  if [[ -e $BINARY || -e $UNIT_DIR/hysteria-server.service || -e $UNIT_DIR/hysteria-server@.service || -e $CONFIG_DIR || -e $SITE || -e $STATE ]]; then
    echo '发现已有 Hysteria 或网站文件，停止以免覆盖。'; return 1
  fi
  if installation_wizard; then :; else
    wizard_result=$?
    (( wizard_result == 2 )) && return 0
    return 1
  fi
  ensure_dependencies || return 1
  archive=$(find_website_archive) && validate_website_archive "$archive" || return 1
  check_ports_available || return 1
  mkdir -p "$STATE" && touch "$STATE/owned" || return 1
  pass=$(openssl rand -hex 24) || return 1
  printf '%s\n' "$pass" > "$STATE/password"
  printf '%s\n' "$DOMAIN" > "$STATE/domain"
  install_website "$archive" && persist_bundle "$archive" || return 1
  echo '正在运行 Hysteria 官方安装脚本。'
  curl -fsSL --retry 3 https://get.hy2.sh/ -o "$STATE/install-official.sh" || return 1
  HYSTERIA_USER=root bash "$STATE/install-official.sh" || return 1
  cat > "$CONFIG" <<EOF
listen: :$PROXY_PORT
acme:
  domains:
    - $DOMAIN
  ca: letsencrypt
  type: http
  dir: $STATE/acme
auth:
  type: password
  password: $pass
masquerade:
  type: file
  file:
    dir: $SITE
  listenHTTPS: :$WEB_PORT
EOF
  chmod 600 "$CONFIG"
  systemctl enable --now "$SERVICE" || { echo '启动失败，请查看日志。'; return 1; }
  wait_for_https || true
  check_status
}

check_status() {
  require_root || return 1
  load_settings
  local failed=0 warnings=0 main_pid active version enabled uptime_text='—'
  local entered uptime_now elapsed public4 public6 dns4 dns6 dns_text http_code tls_ok=0
  local service_text udp_text='[异常] 未监听' tcp_text='[异常] 未监听'
  local site_text cert_text expiry expiry_epoch now_epoch remaining
  local recent protocol_count timeout_count fatal_count recent_text

  active=$(systemctl is-active "$SERVICE" 2>/dev/null) || active=${active:-unknown}
  main_pid=$(systemctl show "$SERVICE" --property=MainPID --value 2>/dev/null) || main_pid=0
  version=$("$BINARY" version 2>/dev/null | awk '$1 == "Version:" {print $2; exit}')
  if systemctl is-enabled --quiet "$SERVICE"; then enabled='已启用'; else enabled='[提醒] 未启用'; warnings=1; fi
  if [[ $active == active ]]; then
    service_text='[正常] 运行中'
    entered=$(systemctl show "$SERVICE" --property=ActiveEnterTimestampMonotonic --value 2>/dev/null) || entered=0
    read -r uptime_now _ < /proc/uptime
    if [[ $entered =~ ^[1-9][0-9]*$ ]]; then
      elapsed=$(( ${uptime_now%%.*} - entered / 1000000 ))
      (( elapsed < 0 )) && elapsed=0
      printf -v uptime_text '%d天 %d小时 %d分钟' "$((elapsed / 86400))" "$((elapsed / 3600 % 24))" "$((elapsed / 60 % 60))"
    fi
  else
    service_text="[异常] 未运行（${active}）"; failed=1
  fi
  if [[ $main_pid =~ ^[1-9][0-9]*$ ]]; then
    ss -H -lnup "sport = :$PROXY_PORT" 2>/dev/null | grep -Fq "pid=$main_pid," && udp_text="[正常] UDP $PROXY_PORT"
    ss -H -lntp "sport = :$WEB_PORT" 2>/dev/null | grep -Fq "pid=$main_pid," && tcp_text="[正常] TCP $WEB_PORT"
  fi
  [[ $udp_text == '[正常]'* && $tcp_text == '[正常]'* ]] || failed=1

  # These are public egress addresses; failure to query is not proof of no IPv6.
  public4=$(curl --noproxy '*' -4fsS --connect-timeout 2 --max-time 3 https://api.ipify.org 2>/dev/null) || public4='未获取'
  public6=$(curl --noproxy '*' -6fsS --connect-timeout 2 --max-time 3 https://api6.ipify.org 2>/dev/null) || public6='未获取'
  [[ $public4 =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || public4='未获取'
  [[ $public6 =~ ^[0-9a-fA-F:]+$ && $public6 == *:* ]] || public6='未获取'
  dns4=$(timeout 4 getent ahostsv4 "$DOMAIN" 2>/dev/null | awk '{print $1}' | sort -u | paste -sd ',' -)
  dns6=$(timeout 4 getent ahostsv6 "$DOMAIN" 2>/dev/null | awk '$1 ~ /:/ && $1 !~ /^::ffff:/ {print $1}' | sort -u | paste -sd ',' -)
  if [[ -n $dns4 && -n $dns6 ]]; then
    dns_text='[正常] A、AAAA 可解析'
  elif [[ -n $dns4 ]]; then
    dns_text='[正常] A 可解析'
  elif [[ -n $dns6 ]]; then
    dns_text='[正常] AAAA 可解析'
  else
    dns_text='[提醒] 暂未取得 A/AAAA 解析结果'; warnings=1
  fi

  if http_code=$(curl --noproxy '*' -sS --connect-timeout 2 --max-time 5 --resolve "$DOMAIN:$WEB_PORT:127.0.0.1" "https://$DOMAIN:$WEB_PORT/" -o /dev/null -w '%{http_code}' 2>/dev/null); then
    tls_ok=1
  fi
  if (( tls_ok )) && [[ $http_code == 200 ]]; then
    site_text='[正常] HTTP 200（本机 HTTPS）'
  else
    site_text="[异常] HTTPS 请求失败或返回非 200（HTTP ${http_code:-000}）"; failed=1
  fi
  expiry=$(timeout 4 openssl s_client -connect "127.0.0.1:$WEB_PORT" -servername "$DOMAIN" </dev/null 2>/dev/null | openssl x509 -noout -enddate 2>/dev/null) || expiry=''
  expiry_epoch=$(date -d "${expiry#notAfter=}" +%s 2>/dev/null) || expiry_epoch=''
  now_epoch=$(date +%s)
  if [[ -n $expiry && $expiry_epoch =~ ^[0-9]+$ ]]; then
    remaining=$((expiry_epoch - now_epoch))
    if (( remaining <= 0 )); then
      cert_text='[异常] 证书已到期'; failed=1
    elif (( ! tls_ok )); then
      cert_text='[异常] 证书存在，但 HTTPS 校验未通过'; failed=1
    elif (( remaining < 1209600 )); then
      cert_text="[提醒] 校验通过 · 剩余 $((remaining / 86400)) 天 · 到期 $(date -u -d "${expiry#notAfter=}" +%F)"; warnings=1
    else
      cert_text="[正常] 校验通过 · 剩余 $((remaining / 86400)) 天 · 到期 $(date -u -d "${expiry#notAfter=}" +%F)"
    fi
  else
    cert_text='[异常] 无法读取正在提供的证书'; failed=1
  fi

  # Count disconnect events once, not every failed stream on the same connection.
  if recent=$(journalctl -u "$SERVICE" --since '10 minutes ago' -o cat --no-pager 2>/dev/null); then
    protocol_count=$(printf '%s\n' "$recent" | awk '/client disconnected/ && /H3_FRAME_UNEXPECTED|expected first frame|0x105/ {n++} END {print n+0}')
    timeout_count=$(printf '%s\n' "$recent" | awk '/client disconnected/ && /timeout: no recent network activity/ {n++} END {print n+0}')
    fatal_count=$(printf '%s\n' "$recent" | awk '/FATAL|failed to load server config|failed to initialize server/ {n++} END {print n+0}')
    if (( protocol_count + timeout_count + fatal_count > 0 )); then
      recent_text="[提醒] 协议断连 ${protocol_count} 次 · 超时断连 ${timeout_count} 次 · 严重错误 ${fatal_count} 条"; warnings=1
    else
      recent_text='未发现协议断连、超时断连或严重错误'
    fi
  else
    recent_text='[提醒] 无法读取日志'; warnings=1
  fi

  printf '\nHysteria 2 状态 · %s（北京时间）\n' "$(TZ=Asia/Shanghai date '+%F %T')"
  if (( failed )); then echo '检查结果    [异常] 需要处理，请查看下列异常项'
  elif (( warnings )); then echo '检查结果    [提醒] 核心服务检查通过，有事项需关注'
  else echo '检查结果    [正常] 服务端核心检查通过'; fi
  printf '服务状态    %s · 持续运行 %s\n' "$service_text" "$uptime_text"
  printf '服务版本    %s · 开机启动 %s\n' "${version:-未获取}" "$enabled"
  printf '服务域名    %s\n' "$DOMAIN"
  printf '网站地址    https://%s:%s/\n' "$DOMAIN" "$WEB_PORT"
  printf '公网 IPv4   %s\n公网 IPv6   %s\n' "$public4" "$public6"
  printf '域名解析    %s\n' "$dns_text"
  printf '代理入口    %s\n网站入口    %s\n' "$udp_text" "$tcp_text"
  printf '域名证书    %s\n网站检查    %s\n' "$cert_text" "$site_text"
  printf '近10分钟    %s\n' "$recent_text"
  echo '公网连接    未进行外部客户端测试（监听、本机访问不代表公网可用）'
  echo '详细日志    请选择菜单 3 查看'
  return "$failed"
}
show_config() {
  require_root && owned && [[ -r $STATE/password ]] || { echo '没有找到本方案的凭据。'; return 1; }
  load_settings
  local pass; read -r pass < "$STATE/password"
  printf '类型：Hysteria 2\n服务器：%s\n端口：%s\nSNI：%s\n密码：%s\nTLS 验证：启用\n分享链接含密码，请妥善保管：\nhysteria2://%s@%s:%s/?sni=%s#Hysteria2-%s\n' "$DOMAIN" "$PROXY_PORT" "$DOMAIN" "$pass" "$pass" "$DOMAIN" "$PROXY_PORT" "$DOMAIN" "$DOMAIN"
}
remove_service() {
  require_root && owned || { echo '未发现本方案管理的安装。'; return 1; }
  confirm '将删除本方案的 Hysteria、网站、配置和凭据，确认删除？' || return 0
  systemctl disable --now "$SERVICE" || true
  if [[ -f $STATE/install-official.sh ]]; then bash "$STATE/install-official.sh" --remove || { echo '官方卸载失败，停止清理。'; return 1; }; fi
  rm -rf -- "$SITE" "$STATE" "$CONFIG_DIR"
  echo '已删除本方案的服务、网站和凭据；菜单脚本、安装用网站包和防火墙规则保留，可再次安装。'
}
# Allow read-only function tests without entering the interactive menu.
if [[ ${BASH_SOURCE[0]} != "$0" ]]; then return 0; fi
require_root || exit 1
load_settings
while true; do
  printf '\nHysteria 2 运维\n1. 安装或重新安装\n2. 检查状态\n3. 查看服务日志\n4. 查看客户端参数和分享链接\n5. 重启服务\n6. 一键删除\n7. 升级 Hysteria 2\n0. 退出\n'
  read -r -p '请选择：' choice || exit 0
  case "$choice" in
    1) install_service ;;
    2) check_status ;;
    3) journalctl -u "$SERVICE" -n 100 --no-pager ;;
    4) show_config ;;
    5) if owned && systemctl restart "$SERVICE"; then wait_for_https || true; check_status; fi ;;
    6) remove_service ;;
    7) upgrade_service ;;
    0) exit 0 ;;
    *) echo '请输入 0–7。' ;;
  esac
done
